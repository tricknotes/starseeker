# Production image, pushed to ghcr.io by .github/workflows/image.yml and run by
# compose.production.yml. The Dockerfile next to it is for development (it
# mounts the checkout and keeps gems in a volume).

FROM ruby:4.0.10-slim AS base
WORKDIR /app
ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development test"
# The base image already has libyaml, and the precompiled pg gem ships its
# own libpq, so jemalloc is the only runtime package added.
RUN apt-get update -qq \
 && apt-get install --no-install-recommends -y libjemalloc2 \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so
# glibc malloc fragments memory across Puma's threads and RSS keeps growing;
# jemalloc keeps it much lower.
ENV LD_PRELOAD=/usr/local/lib/libjemalloc.so
# Ruby only frees garbage when GC runs, and an idle Puma runs none, so after a
# burst of requests the garbage stays allocated and jemalloc cannot hand its
# pages back. The GC limits make GC run before much garbage piles up and keep
# the heap from growing past what is live; jemalloc then returns freed pages
# within a second from a background thread instead of waiting for the next
# allocation. Two arenas are enough for Puma's three threads.
ENV MALLOC_CONF=narenas:2,dirty_decay_ms:1000,muzzy_decay_ms:0,background_thread:true \
    RUBY_GC_HEAP_GROWTH_FACTOR=1.1 \
    RUBY_GC_HEAP_FREE_SLOTS_MAX_RATIO=0.1 \
    RUBY_GC_MALLOC_LIMIT_MAX=8000000 \
    RUBY_GC_OLDMALLOC_LIMIT_MAX=16000000

FROM base AS build
RUN apt-get update -qq \
 && apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*
# The Bundler bundled with the base image lags behind BUNDLED WITH.
# After installing, drop what is only needed to build native extensions, and
# the extensions that precompiled gems ship for other Ruby versions.
COPY Gemfile Gemfile.lock ./
RUN gem install bundler -v "$(awk '/BUNDLED WITH/ { getline; print $1 }' Gemfile.lock)" \
 && bundle install \
 && rm -rf "$BUNDLE_PATH"/ruby/*/cache \
 && find "$BUNDLE_PATH"/ruby/*/gems -type f \( -name '*.[cho]' -o -name Makefile -o -name mkmf.log \) -delete \
 && abi="$(ruby -e 'print RUBY_VERSION[/\A\d+\.\d+/]')" \
 && find "$BUNDLE_PATH"/ruby/*/gems/*/lib -mindepth 1 -maxdepth 2 -type d -regex '.*/[0-9]+\.[0-9]+' ! -name "$abi" -prune \
      -exec sh -c 'ls "$1"/*.so >/dev/null 2>&1 && rm -rf "$1"' _ {} \;
COPY . .
RUN SECRET_KEY_BASE_DUMMY=1 bin/rails assets:precompile

FROM base
# Runs config/crontab in the scheduler service of compose.production.yml.
ADD --checksum=sha256:cc232108374e8e2b537045f2d5eaa1229f619db314c3ba6a14d38b35dc0aa123 --chmod=755 \
    https://github.com/aptible/supercronic/releases/download/v0.2.51/supercronic-linux-amd64 /usr/local/bin/supercronic
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /app /app
RUN groupadd --system --gid 1000 rails \
 && useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash \
 && mkdir -p log tmp \
 && chown -R rails:rails log tmp
USER 1000:1000
EXPOSE 3000
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
