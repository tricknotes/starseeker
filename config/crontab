# Schedule of the recurring tasks for the scheduler service of
# compose.production.yml, read by supercronic (https://github.com/aptible/supercronic).
# Times are UTC. Each line runs one task in the scheduler container; the next
# run of a task does not start while the previous one is still running.

# Star events of each user's followings. Each run looks back 8 hours, so a run
# every 6 hours overlaps the previous one and misses nothing.
0 1,7,13,19 * * * FETCH_CONCURRENCY=20 bin/rails 'star_events:fetch[8]'

# Housekeeping.
0 17 * * * bin/rails update_account_info
30 17 * * * bin/rails remove_old_events

# Put the users who get the daily mail on today's schedule, then send it.
# Sending runs every 30 minutes until midnight: it only mails users still on
# the schedule, so the later runs retry the deliveries that failed and do
# nothing otherwise.
30 20 * * * bin/rails schedule_sending_hot_repositories
0,30 21-23 * * * bin/rails send_hot_repositories
0 0 * * * bin/rails send_hot_repositories
