- @title = 'Daily hot repositories'
- private_feed = feed_url(username: @user.username, format: 'atom', token: @user.feed_token)

= content_for :head do
  = auto_discovery_link_tag :atom, private_feed

%h1
  Daily hot repositories
Starred repositories by #{@user.username}'s followings

%span#feed
  = link_to '[News Feed]', private_feed, target: '_blank', rel: 'noopener noreferrer'

%ul
  - @star_events.starred_ranking.each do |_repo_name, events, repo|
    %li.repo
      -# A table, not a float: this listing is also delivered as an HTML mail,
      -# and floats are dropped by Outlook. The cells keep the repository name
      -# and the people who starred it on one line.
      %table.repo_row
        %tr
          %td.repo_summary
            = image_link_to_github_url repo.owner
            = render 'shared/repository_summary', repo: repo
          %td.repo_stargazers
            - events.each do |event|
              = image_link_to_github_url event.actor
      %div
        %span.description
          = repo.description
